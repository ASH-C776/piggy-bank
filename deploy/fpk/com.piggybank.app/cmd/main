#!/bin/bash
# 存钱罐 · 应用生命周期主脚本
#
# Docker 应用的 start/stop 由应用中心执行 compose 管理，这里写什么都不会被执行
# （官方明确：默认无需定义启停逻辑）；本脚本真正有意义的只有 status ——
# 告诉应用中心「现在到底跑没跑」。
#
# 规则（官方约定）：status 返回 0 = 运行中；返回 3 = 未运行。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running() {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        # 从 compose 里取 container_name（app/docker/docker-compose.yaml 固定为 piggy-bank）
        DOCKER_NAME=$(cat "$FILE_PATH" | grep "container_name" | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q '"Status": "running",' || exit 1
        return
    fi
    # 找不到 compose / container_name 视为未运行
    exit 1
}

case $1 in
start)
    # 应用中心负责启动容器，无需处理
    exit 0
    ;;
stop)
    # 应用中心负责停止容器，无需处理
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
