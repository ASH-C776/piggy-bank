desc=家庭儿童积分管理。<br>· 日常项打卡、临时任务、手动加减分，家长审核后到账<br>· 积分商城兑换、现金兑换（可设汇率）<br>· 身高体重成长曲线，对照中国儿童生长标准看百分位，支持多孩子按年龄对比<br>· 家长端/孩子端分离，数据存在自己 NAS 上<br><br>默认管理员账号 admin / admin123，安装后请尽快修改；JWT_SECRET 建议在应用设置中自行指定。
platform=x86
source=thirdparty
# 开发/维护者信息（上架审核时按实际填写）
maintainer=基耶杰
maintainer_url=https://gitee.com/kijeye/piggy-bank
# 分发者（社区转发打包时填转发者）
#distributor=
#distributor_url=
service_port=3000
os_min_version=1.2.0
# 更新说明（应用中心更新界面展示，面向用户、保持简洁）
changelog=界面优化：底部导航精简（积分流水入口移至首页），头像菜单图标统一为同一套线条风格、行距更紧凑。新增「关于与检查更新」（设置内查看项目名/版本号/作者与开源仓库，自动比对 GitHub 最新版本，有更新时显示角标并一键跳转下载）。成长记录：身高体重曲线对照中国儿童生长标准看百分位，支持多孩子按年龄对比。数据备份与恢复：头像菜单进入，支持立即备份、每日自动备份（默认凌晨3点、保留近7份）、备份下载到手机电脑，恢复需家长密码二次确认且恢复前自动留底可回退。修复飞牛统一网关（/app/ 前缀）下登录页与顶栏图标不显示问题。
desktop_uidir=ui
desktop_applaunchname=com.piggybank.app.main
# 数据全存在容器卷里，不需要用户授权 NAS 目录
disable_authorization_path=true
